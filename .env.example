# OpenAI-compatible /v1 base URL, without /chat/completions.
# DeepSeek example: https://api.deepseek.com/v1 + a model enabled on your account
# GLM example: https://open.bigmodel.cn/api/paas/v4 + a model your account supports.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Configure at least one stock provider; not needed with uploaded MP4 clips.
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://api.coverr.co/docs/
COVERR_API_KEY=
# Edge TTS needs outbound Internet access but no key.
JOB_TIMEOUT_SECONDS=1800
POLL_INTERVAL_SECONDS=3
